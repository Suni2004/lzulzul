{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Listed explicitly so the Jest globals used in `__tests__` resolve;
    // everything else in the app comes in through normal imports.
    "types": ["jest", "node", "react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
